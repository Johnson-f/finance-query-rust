REDIS_URL=

# Proxy configuration (optional)
# PROXY_URL routes ALL requests through the proxy
# PROXY_URL=http://user:pass@proxy.example.com:8080

# AUTH_PROXY_URL routes ONLY Yahoo auth requests through the proxy (recommended)
# This saves bandwidth - only ~10KB per auth vs all data requests
# Use a residential proxy service like Bright Data, IPRoyal, or SmartProxy
# AUTH_PROXY_URL=http://user:pass@brd.superproxy.io:33335